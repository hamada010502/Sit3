node_modules/

# The local database and its write-ahead log. Real orders and real customer
# phone numbers end up here — it must never be committed.
data/*.db
data/*.db-wal
data/*.db-shm

# Secrets.
.env
.env.*
!.env.example

# Build output is regenerated by `npm run build`.
dist/

# Generated responsive images, and the manifest that maps a source image to
# its variants. Both are written by `npm run images` — committing the
# manifest without the files it points at (or vice versa) is exactly how a
# deploy ends up 404ing every <picture> srcset: the page correctly finds an
# entry in the manifest and requests a variant that was never actually
# shipped. Keeping them out of git together means a build that skips
# `npm run images` has NEITHER, and falls back to the plain source image
# (see lib/images.js's `if (!entry)` branch) instead of half-working.
assets/images/generated/
assets/images/manifest.json

# Admin-uploaded product images (local-disk storage backend). In production
# this should be a mounted persistent volume, or the S3-compatible backend
# should be used instead — see DEPLOYMENT.md.
data/uploads/

.DS_Store
*.log
