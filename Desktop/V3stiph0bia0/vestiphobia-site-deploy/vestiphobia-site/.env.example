# VESTIPHOBIA — environment.
#
# Copy to .env.local and fill in. NOTHING in here belongs in git: .env* is
# ignored, and no value from this file is ever sent to the browser.
#
#   cp .env.example .env.local
#
# The server does not read .env itself (no dependency does that here). Export
# the variables, or use `node --env-file=.env.local server/index.js` on Node 22.

# ---------------------------------------------------------------- database
# Leave DATABASE_URL EMPTY for local development: the app then uses SQLite at
# SQLITE_PATH and needs nothing installed.
#
# Set it to a Postgres connection string (Supabase, Neon, RDS, plain Postgres)
# and the exact same code runs against Postgres instead. That is the only
# change required — see server/db/postgres.md.
#
# Supabase: Project Settings -> Database -> Connection string -> URI, and use
# the pooled (pgbouncer, port 6543) URI for a serverless host, the direct
# (port 5432) one for a long-running server.
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# Where the local SQLite file lives. Default: ./data/vestiphobia.db
# SQLITE_PATH=./data/vestiphobia.db

# Postgres connection pool size (only relevant when DATABASE_URL is set).
# PG_POOL_MAX=10

# ------------------------------------------------------------------ server
PORT=4000
HOST=0.0.0.0

# Set to 1 ONLY when the app sits behind a proxy you control (Fly, Render,
# Nginx). It makes the app trust two headers that proxy sets: X-Forwarded-For
# (the client address every rate limit is keyed on) and X-Forwarded-Proto (how
# the app knows the request arrived over HTTPS when TLS was terminated at the
# proxy). Leave it UNSET when there is no such proxy: anyone could then forge
# their own address and walk past every rate limit.
#
# If your proxy terminates TLS you MUST set this, or the admin session cookie
# loses its Secure flag and no HSTS header is sent. A direct TLS connection to
# the app is recognised either way.
# TRUST_PROXY=1

# Salt for hashing IP addresses in the audit log. Change it to any long random
# string. IPs are never stored raw, and with a per-deployment salt a stolen
# database cannot be scanned for a known address.
IP_SALT=change-this-to-a-long-random-string

# Orders accepted from one IP per hour. The default suits a shop; raise it only
# if a legitimate burst is ever refused (a shared office or carrier NAT makes
# many customers look like one address).
# ORDER_RATE_LIMIT=30

# Analytics batches accepted from one IP per hour. A browsing visitor sends a
# handful; the default leaves room for a household behind one address.
# EVENTS_RATE_LIMIT=600

# Admin changes accepted from one signed-in account per hour, and the tighter
# ceiling for image uploads specifically (they cost CPU to resize and money to
# store). Both sit far above a heavy day of real admin work; they exist so a
# STOLEN session cookie cannot be used to grind the image pipeline or fill the
# database. Signing out is never limited.
# ADMIN_WRITE_LIMIT=300
# ADMIN_UPLOAD_LIMIT=60

# How long a SQLite write waits for the lock before giving up, and how many
# times a transaction that lost the lock is retried. The defaults were chosen
# against the concurrency tests in qa/inventory-race.mjs — change them only
# with a measurement in hand.
# SQLITE_BUSY_TIMEOUT_MS=15000
# DB_TX_ATTEMPTS=8

# ------------------------------------------------------------------- admin
# Used ONLY by `npm run db:seed` to create the very first admin account, and
# only when no admin exists yet. Prefer `npm run admin:create` and leave these
# unset, so a password never sits in a file.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=a long passphrase of at least 12 characters

# ---------------------------------------------------------------- uploads
# Product images uploaded from Admin. Local disk by default — zero setup, but
# the directory MUST sit on a persistent volume in production (most PaaS
# filesystems are wiped on every redeploy). Default: ./data/uploads
# UPLOADS_DIR=/data/uploads

# RECOMMENDED for production: set ALL THREE of these to switch to Supabase
# Storage — no code change, no extra dependency, and it survives every
# redeploy regardless of the host's filesystem. Takes priority over the
# generic S3 variables below if both happen to be set. See DEPLOYMENT.md §3b
# for the exact bucket setup. SUPABASE_SERVICE_ROLE_KEY is a server secret —
# it is used only here, server-side, and must never reach the browser.
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=product-images

# Alternative: set ALL FOUR of these to use any other S3-compatible object
# storage instead (Cloudflare R2, AWS S3, …).
# S3_BUCKET=vestiphobia-uploads
# S3_ENDPOINT=https://PROJECT.supabase.co/storage/v1/s3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_PUBLIC_URL=

# Largest accepted upload, in bytes. Default: 8388608 (8MB)
# MAX_UPLOAD_BYTES=8388608

# -------------------------------------------------------------------- mail
# No provider is wired up. Queued mail sits in email_outbox and is visible in
# Admin -> Emails. When you add one, implement dispatch() in
# server/routes/emails.js and put its key here.
# EMAIL_PROVIDER=
# EMAIL_API_KEY=
# EMAIL_FROM=orders@yourdomain.com
