# Secret used to sign login cookies. Change in production.
SESSION_SECRET=change-me-in-production

# SQLite file and the directory uploaded images are served from
DATABASE_PATH=./data/paylo.db
UPLOAD_DIR=./data/uploads

# Public base URL used in links inside notifications
APP_URL=http://localhost:3000

# --- Payment (Full Spec v2 section 3) ---
# Card checkout stays hidden until a bank confirms in writing what it will settle.
# Enabling it needs BOTH this variable and the admin "card_enabled" setting.
PAYMENT_CARD_ENABLED=0
# Card adapter once the gate opens: "mock" (development) or "qnb" (stub awaiting the contract)
PAYMENT_PROVIDER=mock

# --- Notifications ---
# "log" records the exact message in the database, visible under Admin > Notifications.
EMAIL_TRANSPORT=log
SMS_TRANSPORT=log
WHATSAPP_TRANSPORT=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Paylo <no-reply@paylo.sy>

# --- Owner account (single, hard-coded identity — see lib/owner.ts) ---
# The one email that /owner will ever authorize, checked in Edge middleware in
# addition to the DB role flag. Must be set explicitly in any real deployment;
# the code fallback is for local development only.
OWNER_EMAIL=owner@paylo.sy
# Only read by scripts/seed.js when first creating the account.
OWNER_SEED_PASSWORD=owner-change-me-1234

# --- Analytics (owner dashboards) ---
# Shared secret for a scheduled job to call POST /api/internal/refresh-analytics.
# Leave unset to disable that endpoint entirely (the in-app "Refresh now" button
# still works without it — see docs/technical-addendum.md).
ANALYTICS_REFRESH_SECRET=
