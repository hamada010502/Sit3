# Secret used to sign login cookies. Change in production.
SESSION_SECRET=change-me-in-production
# Path to the SQLite database file
DATABASE_PATH=./data/paylo.db
# Payment provider adapter: "mock" (dev/test) or "qnb" (stub until PSP contract is signed)
PAYMENT_PROVIDER=mock
# Email transport: "log" (stored in DB, visible in admin) or "smtp"
EMAIL_TRANSPORT=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Paylo <no-reply@paylo.sy>
# Public base URL used in emails and share links
APP_URL=http://localhost:3000
UPLOAD_DIR=./data/uploads
